# Variáveis para docker-compose.yml (produção, VPS). Copie para `.env` e
# preencha com valores reais — nunca commite o `.env` real (ver .gitignore).
POSTGRES_USER=opfy
POSTGRES_PASSWORD=troque-por-um-segredo-forte
POSTGRES_DB=opfy_board
WEB_ORIGIN=https://app.opfyboard.com
NEXT_PUBLIC_API_URL=https://api.opfyboard.com
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_HASH_SECRET=troque-por-outro-segredo-forte
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
